{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "baseUrl": "../reels-studio",
    "paths": {"*": ["node_modules/@types/*", "node_modules/*"]}
  },
  "include": ["app/**/*.ts", "app/**/*.tsx"]
}
