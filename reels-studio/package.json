{
  "name": "reels-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:reel": "remotion render src/index.ts Reel ../finished-videos/reel.mp4",
    "render:text": "remotion render src/index.ts TextReel ../finished-videos/text-reel.mp4",
    "cover": "remotion still src/index.ts Reel ../finished-videos/cover.png --frame=45",
    "upgrade": "remotion upgrade",
    "frames": "python3 scripts/frames.py",
    "transcribe": "python3 scripts/transcribe.py",
    "setup:whisper": "bash scripts/setup-whisper.sh",
    "cut": "python3 scripts/cut_pauses.py",
    "site": "node scripts/site_shot.mjs",
    "matte": "python3 scripts/matte.py",
    "stories": "python3 scripts/stories.py"
  },
  "dependencies": {
    "@remotion/captions": "4.0.533",
    "@remotion/cli": "4.0.533",
    "@remotion/elevenlabs": "4.0.533",
    "@remotion/google-fonts": "4.0.533",
    "@remotion/install-whisper-cpp": "4.0.533",
    "@remotion/layout-utils": "4.0.533",
    "@remotion/media": "4.0.533",
    "@remotion/motion-blur": "4.0.533",
    "@remotion/noise": "4.0.533",
    "@remotion/sfx": "4.0.533",
    "@remotion/transitions": "4.0.533",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.533",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.4.0"
  }
}
