[{"start": 1.53, "end": 2.88, "text": "Пять чатов в Telegram.", "hint": "", "question": "", "beat": "c01"}, {"start": 2.89, "end": 4.26, "text": "Два в WeChat.", "hint": "", "question": "", "beat": "c01"}, {"start": 4.31, "end": 5.32, "text": "Ещё WhatsApp.", "hint": "", "question": "", "beat": "c01"}, {"start": 5.609, "end": 6.739, "text": "Сотни сообщений.", "hint": "", "question": "", "beat": "c02"}, {"start": 6.769, "end": 11.799, "text": "И нужное сообщение, как всегда, невозможно найти в череде всех этих мессенджеров и чатов!", "hint": "", "question": "", "beat": "c02"}, {"start": 12.075, "end": 14.895, "text": "А теперь одно приложение для всей группы.", "hint": "", "question": "", "beat": "c03"}, {"start": 15.225, "end": 19.725, "text": "Открываете и сразу видно главное: что сейчас, куда едем и когда выезд.", "hint": "", "question": "", "beat": "c05"}, {"start": 19.875, "end": 21.235, "text": "Вся программа по дням.", "hint": "", "question": "", "beat": "c05"}, {"start": 21.235, "end": 24.095, "text": "Весь маршрут визуализирован и показан на карте.", "hint": "", "question": "", "beat": "c05"}, {"start": 25.644, "end": 29.454, "text": "Чеки формируются в единый отчёт в формате Excel и PDF.", "hint": "", "question": "", "beat": "c09"}, {"start": 29.484, "end": 32.364, "text": "Суммы фиксируются в любой выбранной валюте автоматически.", "hint": "", "question": "", "beat": "c09"}, {"start": 32.404, "end": 35.994, "text": "Бухгалтер получает всё одним готовым файлом с фото и цифрами.", "hint": "", "question": "", "beat": "c09"}, {"start": 36.024, "end": 37.574, "text": "И вы не теряете время на отчёты.", "hint": "", "question": "", "beat": "c09"}, {"start": 37.944, "end": 47.414, "text": "В конце итоговый отчёт по каждой поездке и структурированный майндмэп: время, день, компания, договорённости, контакты, следующие шаги.", "hint": "", "question": "", "beat": "c10"}, {"start": 47.414, "end": 49.834, "text": "Всё под рукой и собирается автоматически.", "hint": "", "question": "", "beat": "c10"}, {"start": 50.169, "end": 54.579, "text": "В городе переводчик, карта без интернета и кнопка экстренного вызова одним движением.", "hint": "", "question": "", "beat": "c11"}, {"start": 54.866, "end": 55.626, "text": "Global Tech Tour.", "hint": "", "question": "", "beat": "c14"}, {"start": 55.726, "end": 57.576, "text": "Вся поездка в одном приложении.", "hint": "", "question": "", "beat": "c14"}]