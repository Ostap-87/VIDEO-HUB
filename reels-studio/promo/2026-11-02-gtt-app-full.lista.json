[{"start": 1.53, "end": 2.88, "text": "Пять чатов в Telegram.", "hint": "", "question": "", "beat": "c01"}, {"start": 2.89, "end": 4.26, "text": "Два в WeChat.", "hint": "", "question": "", "beat": "c01"}, {"start": 4.31, "end": 5.32, "text": "Ещё WhatsApp.", "hint": "", "question": "", "beat": "c01"}, {"start": 5.609, "end": 6.739, "text": "Сотни сообщений.", "hint": "", "question": "", "beat": "c02"}, {"start": 6.769, "end": 11.799, "text": "И нужное сообщение, как всегда, невозможно найти в череде всех этих мессенджеров и чатов!", "hint": "", "question": "", "beat": "c02"}, {"start": 12.075, "end": 14.895, "text": "А теперь одно приложение для всей группы.", "hint": "", "question": "", "beat": "c03"}, {"start": 15.225, "end": 17.795, "text": "Global Tech Tour максимальное удобство для группы.", "hint": "", "question": "", "beat": "c04"}, {"start": 17.855, "end": 21.555, "text": "У делегата вся поездка в телефоне, у координатора вся группа как на ладони.", "hint": "", "question": "", "beat": "c04"}, {"start": 21.899, "end": 26.399, "text": "Открываете и сразу видно главное: что сейчас, куда едем и когда выезд.", "hint": "", "question": "", "beat": "c05"}, {"start": 26.549, "end": 27.909, "text": "Вся программа по дням.", "hint": "", "question": "", "beat": "c05"}, {"start": 27.909, "end": 30.769, "text": "Весь маршрут визуализирован и показан на карте.", "hint": "", "question": "", "beat": "c05"}, {"start": 32.29, "end": 34.34, "text": "(без голоса) Питание и аллергии", "hint": "ЕЩЁ В ПРИЛОЖЕНИИ · 01/14", "question": "", "beat": "m01"}, {"start": 34.59, "end": 36.64, "text": "(без голоса) Подготовка к поездке", "hint": "ЕЩЁ В ПРИЛОЖЕНИИ · 02/14", "question": "", "beat": "m02"}, {"start": 36.897, "end": 41.347, "text": "Одна кнопка «Я в автобусе» и координатор видит, кто на месте.", "hint": "", "question": "", "beat": "c06"}, {"start": 41.357, "end": 44.447, "text": "Объявления, опросы и чат тоже здесь.", "hint": "", "question": "", "beat": "c06"}, {"start": 44.597, "end": 46.017, "text": "И ничего не теряется.", "hint": "", "question": "", "beat": "c06"}, {"start": 46.44, "end": 48.49, "text": "(без голоса) Расселение по номерам", "hint": "ЕЩЁ В ПРИЛОЖЕНИИ · 03/14", "question": "", "beat": "m03"}, {"start": 48.74, "end": 50.79, "text": "(без голоса) Вся группа на карте", "hint": "ЕЩЁ В ПРИЛОЖЕНИИ · 04/14", "question": "", "beat": "m04"}, {"start": 51.04, "end": 53.09, "text": "(без голоса) Питание группы — ресторану", "hint": "ЕЩЁ В ПРИЛОЖЕНИИ · 05/14", "question": "", "beat": "m05"}, {"start": 53.34, "end": 55.39, "text": "(без голоса) Вопросы компании — заранее", "hint": "ЕЩЁ В ПРИЛОЖЕНИИ · 06/14", "question": "", "beat": "m06"}, {"start": 55.662, "end": 59.722, "text": "Во время визита заметки голосом и фото, радиогид с субтитрами.", "hint": "", "question": "", "beat": "c07"}, {"start": 59.802, "end": 65.262, "text": "А визитки можно сразу сканировать и сохранять потому что есть автоматическое распознавание любых языков.", "hint": "", "question": "", "beat": "c07"}, {"start": 65.51, "end": 67.56, "text": "(без голоса) Визитки → Excel и CRM", "hint": "ЕЩЁ В ПРИЛОЖЕНИИ · 07/14", "question": "", "beat": "m07"}, {"start": 67.81, "end": 69.86, "text": "(без голоса) Что нужно после визита", "hint": "ЕЩЁ В ПРИЛОЖЕНИИ · 08/14", "question": "", "beat": "m08"}, {"start": 70.119, "end": 80.649, "text": "И всё связано с нужными инструментами: календарь, карты Amap, Dianping и Meituan, отчёты в любом формате Excel, Word, PDF и выгрузка в CRM, мини-программа WeChat для компаний и партнёров.", "hint": "", "question": "", "beat": "c08"}, {"start": 80.957, "end": 84.767, "text": "Чеки формируются в единый отчёт в формате Excel и PDF.", "hint": "", "question": "", "beat": "c09"}, {"start": 84.797, "end": 87.677, "text": "Суммы фиксируются в любой выбранной валюте автоматически.", "hint": "", "question": "", "beat": "c09"}, {"start": 87.717, "end": 91.307, "text": "Бухгалтер получает всё одним готовым файлом с фото и цифрами.", "hint": "", "question": "", "beat": "c09"}, {"start": 91.337, "end": 92.887, "text": "И вы не теряете время на отчёты.", "hint": "", "question": "", "beat": "c09"}, {"start": 93.257, "end": 102.727, "text": "В конце итоговый отчёт по каждой поездке и структурированный майндмэп: время, день, компания, договорённости, контакты, следующие шаги.", "hint": "", "question": "", "beat": "c10"}, {"start": 102.727, "end": 105.147, "text": "Всё под рукой и собирается автоматически.", "hint": "", "question": "", "beat": "c10"}, {"start": 105.482, "end": 109.892, "text": "В городе переводчик, карта без интернета и кнопка экстренного вызова одним движением.", "hint": "", "question": "", "beat": "c11"}, {"start": 110.15, "end": 112.2, "text": "(без голоса) Адрес — таксисту", "hint": "ЕЩЁ В ПРИЛОЖЕНИИ · 09/14", "question": "", "beat": "m09"}, {"start": 112.45, "end": 114.5, "text": "(без голоса) Аллергии — официанту", "hint": "ЕЩЁ В ПРИЛОЖЕНИИ · 10/14", "question": "", "beat": "m10"}, {"start": 114.75, "end": 116.8, "text": "(без голоса) Аптека: покажите фармацевту", "hint": "ЕЩЁ В ПРИЛОЖЕНИИ · 11/14", "question": "", "beat": "m11"}, {"start": 117.05, "end": 119.1, "text": "(без голоса) Фруктовые лавки", "hint": "ЕЩЁ В ПРИЛОЖЕНИИ · 12/14", "question": "", "beat": "m12"}, {"start": 119.35, "end": 121.4, "text": "(без голоса) Еда и места рядом", "hint": "ЕЩЁ В ПРИЛОЖЕНИИ · 13/14", "question": "", "beat": "m13"}, {"start": 121.65, "end": 123.7, "text": "(без голоса) Юани → рубли", "hint": "ЕЩЁ В ПРИЛОЖЕНИИ · 14/14", "question": "", "beat": "m14"}, {"start": 123.979, "end": 125.839, "text": "Организатору пульт поездки.", "hint": "", "question": "", "beat": "c12"}, {"start": 126.049, "end": 128.689, "text": "Принимающей стороне мини-программа на китайском.", "hint": "", "question": "", "beat": "c12"}, {"start": 128.759, "end": 131.329, "text": "Делегату спокойствие и удобство.", "hint": "", "question": "", "beat": "c12"}, {"start": 131.7, "end": 134.38, "text": "Для каждой из семидесяти шести программ в девяти странах.", "hint": "", "question": "", "beat": "c13"}, {"start": 135.321, "end": 136.081, "text": "Global Tech Tour.", "hint": "", "question": "", "beat": "c14"}, {"start": 136.181, "end": 138.031, "text": "Вся поездка в одном приложении.", "hint": "", "question": "", "beat": "c14"}]