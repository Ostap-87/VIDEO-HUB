# Видео и тяжёлые медиа хранятся через Git LFS
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.m4v filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.MP4 filter=lfs diff=lfs merge=lfs -text
*.MOV filter=lfs diff=lfs merge=lfs -text
*.m4a filter=lfs diff=lfs merge=lfs -text
*.aac filter=lfs diff=lfs merge=lfs -text

# Звуки внутри скиллов маленькие, храним их в обычном git, не в LFS
.claude/skills/**/*.mp3 -filter -diff -merge binary
# Фоновая музыка из интернета — пара треков по ~3 МБ, тоже в обычном git
интернет-материалы/музыка/*.mp3 -filter -diff -merge binary
# Презентации
*.pptx filter=lfs diff=lfs merge=lfs -text
*.key filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
